<?xml version="1.0"?>
<!--
  URDF description for custom 4-wheel differential drive robot
  Used by robot_state_publisher for static transforms
-->
<robot name="custom_4wheel_robot">

  <!-- Base footprint (ground plane reference) -->
  <link name="base_footprint"/>

  <!-- Base link (robot center) -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.035 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.32 0.10"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.035 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.43 0.32 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.035 0 0.05" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.054" ixy="0" ixz="0"
               iyy="0.096" iyz="0"
               izz="0.126"/>
    </inertial>
  </link>

  <!-- Front Left Wheel -->
  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00106" ixy="0" ixz="0"
               iyy="0.00106" iyz="0"
               izz="0.00169"/>
    </inertial>
  </link>

  <!-- Front Right Wheel -->
  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00106" ixy="0" ixz="0"
               iyy="0.00106" iyz="0"
               izz="0.00169"/>
    </inertial>
  </link>

  <!-- Rear Left Wheel -->
  <link name="rear_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00106" ixy="0" ixz="0"
               iyy="0.00106" iyz="0"
               izz="0.00169"/>
    </inertial>
  </link>

  <!-- Rear Right Wheel -->
  <link name="rear_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <cylinder radius="0.092" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.00106" ixy="0" ixz="0"
               iyy="0.00106" iyz="0"
               izz="0.00169"/>
    </inertial>
  </link>

  <!-- Lidar Mounting Post -->
  <link name="lidar_post">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.05"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="0.000004" ixy="0" ixz="0"
               iyy="0.000004" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>

  <!-- Lidar Link (LD19) -->
  <link name="base_scan">
    <!-- Mounting base/bracket -->
    <visual>
      <origin xyz="0 0 0.0075" rpy="0 0 0"/>
      <geometry>
        <box size="0.054 0.0468 0.015"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <!-- Main cylindrical body -->
    <visual>
      <origin xyz="0 0 0.0245" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0234" length="0.019"/>
      </geometry>
      <material name="white">
        <color rgba="0.9 0.9 0.9 1.0"/>
      </material>
    </visual>
    <!-- Top scanning window/dome -->
    <visual>
      <origin xyz="0 0 0.0385" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.009"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 0.8"/>
      </material>
    </visual>
    <!-- Collision geometry -->
    <collision>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.043"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <mass value="0.035"/>
      <inertia ixx="0.00001" ixy="0" ixz="0"
               iyy="0.00001" iyz="0"
               izz="0.00001"/>
    </inertial>
  </link>

  <!-- Camera Link -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.1 0.03"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.1 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00008583" ixy="0" ixz="0"
               iyy="0.00006083" iyz="0"
               izz="0.00002583"/>
    </inertial>
  </link>

  <!-- IMU Link -->
  <link name="imu_link"/>

  <!-- Joints -->

  <!-- Base footprint to base_link -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.092" rpy="0 0 0"/>
  </joint>

  <!-- Front left wheel joint -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.15 0.202 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front right wheel joint -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.15 -0.202 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear left wheel joint -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.15 0.202 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear right wheel joint -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.15 -0.202 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Camera joint -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.195 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Lidar post joint -->
  <joint name="lidar_post_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_post"/>
    <origin xyz="-0.035 0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- Lidar joint -->
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_post"/>
    <child link="base_scan"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- IMU joint -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

</robot>
